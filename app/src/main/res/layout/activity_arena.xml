<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background_escuro">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="35dp"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_arena"
            android:textColor="@color/neon_rosa"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/pontuacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/placar"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/escolha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/escolher_jogada"
            android:textColor="@color/neon_azul"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnPedra"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/cor_fundo"
                android:contentDescription="@string/opc_pedra"
                android:scaleType="fitCenter"
                android:src="@drawable/pedra" />

            <ImageButton
                android:id="@+id/btnPapel"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/cor_fundo"
                android:contentDescription="@string/opc_papel"
                android:scaleType="fitCenter"
                android:src="@drawable/papel" />

            <ImageButton
                android:id="@+id/btnTesoura"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="8dp"
                android:background="@color/cor_fundo"
                android:contentDescription="@string/opc_tesoura"
                android:scaleType="fitCenter"
                android:src="@drawable/tesoura" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/batalha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/voce"
                            android:textColor="@color/neon_azul"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/escolhaJogador"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/cor_fundo"
                            android:contentDescription="@string/sua_escolha"
                            android:src="@drawable/pedra" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vs"
                        android:textColor="@color/termo_amarelo"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dispositivo"
                            android:textColor="@color/neon_rosa"
                            android:textSize="14sp" />

                        <ImageView
                            android:id="@+id/escolhaCpu"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/cor_fundo"
                            android:contentDescription="@string/escolha_do_dispositivo"
                            android:src="@drawable/pedra" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/resultadoRound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/escolha_uma_opcao"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnResetarJogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/neon_laranja"
            android:text="@string/btn_novo_jogo"
            android:textColor="@color/white"
            android:visibility="gone"
            android:layout_marginBottom="16dp"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/fimPartida"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text=""
            android:textAlignment="center"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:padding="10dp"
            android:textColor="@color/termo_amarelo"
            android:visibility="visible"/>

        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card"
            android:text="@string/btn_voltar"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/card"
            android:text="@string/btn_sair"
            android:textColor="@color/termo_amarelo"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>