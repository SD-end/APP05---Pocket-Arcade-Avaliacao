<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_escuro"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_randomizador"
        android:textColor="@color/neon_roxo"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="35dp"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/palavra"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@color/card"
            android:hint="@string/dica_palavra"
            android:inputType="textCapSentences"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/white"
            android:textColorHint="@color/termo_cinza"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/spnCategorias"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@color/card"
            android:entries="@array/categorias_sorteio"
            android:padding="8dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAdicionar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/neon_roxo"
            android:text="@string/btn_adicionar"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSortear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/neon_laranja"
            android:text="@string/btn_sortear"
            android:textColor="@color/white" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardResultadoSorteio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/card"
        app:cardCornerRadius="10dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvResultadoSorteio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/neon_azul"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Sorteado: Star Wars" />
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/lista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="4dp"
            android:padding="14dp"
            android:textStyle="bold"
            android:textAlignment="textEnd"
            android:backgroundTint="@color/card"
            android:text="@string/lista"
            android:textColor="@color/neon_laranja" />

        <Switch
            android:id="@+id/alternarLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:padding="14dp"
            android:textAlignment="center"
            android:backgroundTint="@color/card"
            android:textColor="@color/white"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

        <TextView
            android:id="@+id/grade"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginStart="4dp"
            android:padding="14dp"
            android:textStyle="bold"
            android:textAlignment="textStart"
            android:backgroundTint="@color/card"
            android:text="@string/grade"
            android:textColor="@color/white" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/itens"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp">

    </androidx.recyclerview.widget.RecyclerView>

    <Button
        android:id="@+id/btnVoltar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card"
        android:text="@string/btn_voltar"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnSair"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/card"
        android:text="@string/btn_sair"
        android:textColor="@color/termo_amarelo"
        android:layout_marginBottom="12dp" />

</LinearLayout>